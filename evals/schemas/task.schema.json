{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Layer 3 task definition",
  "type": "object",
  "required": ["id", "skill", "title", "prompt", "expected_artifacts", "deterministic_checks"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$" },
    "skill": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 5 },
    "prompt": { "type": "string", "minLength": 20 },
    "expected_artifacts": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "deterministic_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "type"],
        "additionalProperties": false,
        "properties": {
          "id":          { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "description": { "type": "string", "minLength": 5 },
          "type": {
            "type": "string",
            "enum": ["grep", "regex", "not_contains", "file_exists", "json_path"]
          },
          "glob":        { "type": "string" },
          "pattern":     { "type": "string" },
          "flags":       { "type": "string" },
          "must_match":  { "type": "boolean" },
          "path":        { "type": "string" },
          "json_path":   { "type": "string" },
          "expected":    {}
        }
      }
    },
    "judge_rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description", "weight"],
            "additionalProperties": false,
            "properties": {
              "name":        { "type": "string" },
              "description": { "type": "string" },
              "weight":      { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "pass_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "judge_model":    { "type": "string" }
      }
    }
  }
}
